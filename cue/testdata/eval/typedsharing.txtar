# Typed references to final values are shared when the type resolves to the
# referenced value: the value was constrained by one of the definitions of the
# type, and each other definition cannot be unified with it. These cases check
# that results do not change where this does not hold.
-- in.cue --
// A value that embeds a definition is not closed by it.
embedded: {
	#A: {a?: int, deps?: [...#N]}
	#B: {b!: string, deps?: [...#N]}
	#N: #A | #B
	x: {#A, extra: 1}
	y: #A & {a: 1}
	l: [...#N]
	l: [x, y]
}

// A default of the referenced value is not a hard constraint.
defaults: {
	#A: {kind: "a", f: *"a" | string, deps?: [...#N]}
	#B: {kind: "b", deps?: [...#N]}
	#N: #A | #B
	t: [string]: #N
	t: {
		p: {kind: "a"}
		q: {kind: "a", f: "z", deps: [p]}
	}
	l: [...#N]
	l: [t.p, t.q]
}

// Definitions that are not disjoint keep the disjunction.
ambiguous: {
	#A: {x?: int}
	#B: {y?: int}
	#N: #A | #B
	v: #A & {}
	l: [...#N]
	l: [v]
}

// Closedness errors of a dependency are reported at each reference.
closed: {
	#T: {cmd: string, deps?: [...(#T | #G)]}
	#G: {type: "group", deps?: [...(#T | #G)]}
	tasks: [string]: #T | #G
	tasks: {
		a: {cmd: "x"}
		b: {cmd: "x", deps: [a]}
		c: {cmd: "x", deps: [b], bogus: 1}
		d: {cmd: "x", deps: [c]}
	}
}

// Forward references are shared once their target is complete.
forward: {
	#T: {cmd: string, out: string | *"default", deps?: [...(#T | #G)]}
	#G: {type: "group", deps?: [...(#T | #G)]}
	tasks: [string]: #T | #G
	tasks: {
		d: {cmd: "x", deps: [c]}
		c: {cmd: "x", deps: [b], out: "c"}
		b: {cmd: "x", deps: [a]}
		a: {cmd: "x"}
		g: {type: "group", deps: [d, a]}
	}
}

// A self-reference is not shared.
self: {
	#A: y: string
	#B: x: #A
	#C: {
		x: #A
		v: #B & {x: x}
	}
	config: #C & {x: y: "dev"}
}

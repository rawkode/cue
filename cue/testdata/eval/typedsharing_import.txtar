# Typed references into an imported package are shared under the conditions
# of typedsharing.txtar: the referenced field is final, is reached from the
# root of the package by regular fields, was constrained by one of the
# definitions of the type with its closedness enforced, and each other
# definition of the type cannot be unified with it. These cases check that
# results do not change where this does not hold: every value and error
# below is that of the evaluator without sharing.
-- cue.mod/module.cue --
module: "mod.test"
language: version: "v0.14.1"
-- in.cue --
package main

import (
	"mod.test/schema"
	"mod.test/dep"
	renamed "mod.test/dep"
	"mod.test/failing"
	"mod.test/conflict"
	"mod.test/upper"
)

schema.#Project

name: "main"

// Shared: a field typed by a pattern of the package or by a direct
// reference, a group, a field of a group, and a field of another struct.
tasks: {
	pattern: {cmd: "x", deps: [dep.tasks.a]}
	direct: {cmd: "x", deps: [dep.tasks.b]}
	group: {cmd: "x", deps: [dep.tasks.g]}
	child: {cmd: "x", deps: [dep.tasks.g.inner]}
	subgroup: {cmd: "x", deps: [dep.tasks.outer]}
	nested: {cmd: "x", deps: [dep.nested.deep]}
	local: {cmd: "x", deps: [pattern, dep.tasks.a, renamed.tasks.a]}
	chain: {cmd: "x", deps: [upper.tasks.top]}
	computed: {cmd: "x", deps: [dep.tasks.t1]}
	referenced: {cmd: "x", deps: [dep.ref.tasks.ok]}
	viaLocal: {cmd: "x", deps: [dep.tasks.viaLocal]}
	hidden: {cmd: "x", deps: [dep.tasks.hid]}
	abstract: {cmd: "x", deps: [dep.tasks.abstract]}
	within: {type: "group", deps: [dep.tasks.a], kid: {cmd: "k", deps: [dep.tasks.b]}}
	fromTemplate: #Template & {out: "o"}
}
#Template: schema.#Task & {cmd: "t", deps: [dep.tasks.a]}

// The referenced value was not constrained by a definition of the type.
plain: schema.#Task & {cmd: "x", deps: [dep.plain]}

// A value that embeds a definition is not closed by it.
embedded: schema.#Task & {cmd: "x", deps: [dep.embedded]}

// A field that the package may declare because it embeds the definition is
// not allowed where the value is unified with the definition again.
allowed: schema.#Task & {cmd: "x", deps: [dep.tasks.bad]}
allowedNested: schema.#Task & {cmd: "x", deps: [dep.tasks.badNested]}
allowedChild: schema.#Task & {cmd: "x", deps: [dep.tasks.badGroup]}
allowedOnly: schema.#Task & {cmd: "x", deps: [dep.tasks.badGroup.kid]}
allowedSibling: schema.#Task & {cmd: "x", deps: [dep.tasks.badGroup.fine]}
inStruct: schema.#Task & {cmd: "x", deps: [dep.inner.tasks.ok]}
inStructAllowed: schema.#Task & {cmd: "x", deps: [dep.inner.tasks.bad]}

// A value that lacks a required field.
partial: schema.#Task & {cmd: "x", deps: [dep.partial]}

// An optional field cannot be referenced.
optional: schema.#Task & {cmd: "x", deps: [dep.opt]}

// A definition is a type, not a value of it.
definition: schema.#Task & {cmd: "x", deps: [dep.#Def]}

// A field of a definition.
inDefinition: schema.#Task & {cmd: "x", deps: [dep.#Holder.task]}

// Fields that are computed.
dynamic: schema.#Task & {cmd: "x", deps: [dep.dynamic]}
generated: schema.#Task & {cmd: "x", deps: [dep.gen.c1]}
guarded: schema.#Task & {cmd: "x", deps: [dep.guarded.task]}

// A field that is itself a reference.
alias: schema.#Task & {cmd: "x", deps: [dep.alias]}

// A reference through a let is not a selection from the package.
let Tasks = dep.tasks
viaLet: schema.#Task & {cmd: "x", deps: [Tasks.a]}

// An element of a list is not selected by a field.
element: schema.#Task & {cmd: "x", deps: [dep.list[0]]}

// A value that still has alternatives.
either: schema.#Task & {cmd: "x", deps: [dep.either]}

// A value with a default keeps it.
defaulted: schema.#Task & {cmd: "x", deps: [dep.defaulted]}

// A reference that is one of several alternatives.
choice: schema.#Task & {cmd: "x", deps: [*dep.tasks.a | dep.tasks.b]}

// Errors of the referenced value are reported at each reference.
broken: schema.#Task & {cmd: "x", deps: [dep.broken]}
cyclic: schema.#Task & {cmd: "x", deps: [dep.cyclic]}
missing: schema.#Task & {cmd: "x", deps: [dep.tasks.nope]}

// A reference with a further constraint is unified, not shared.
constrained: schema.#Task & {cmd: "x", deps: [dep.tasks.a & {out: "changed"}]}
both: schema.#Task & {cmd: "x", deps: [dep.tasks.a & dep.tasks.b]}

// Definitions that are not disjoint keep the disjunction.
ambiguous: schema.#Loose & {deps: [dep.loose]}

// A type that the value was not constrained by.
mismatch: schema.#Loose & {deps: [dep.tasks.a]}

// A struct of the package that is an error, and a package that has one.
failed: schema.#Task & {cmd: "x", deps: [failing.s.x]}
sibling: schema.#Task & {cmd: "x", deps: [failing.ok]}
conflicting: schema.#Task & {cmd: "x", deps: [conflict.ok]}
-- schema/schema.cue --
package schema

#Task: {
	type?: _|_
	cmd!:  string
	out:   string | *"default"
	meta?: #Meta
	deps?: [...#Node]
}
#Meta: {label?: string}
#Group: {
	type: "group"
	deps?: [...#Node]
	[!~"^(type|deps)$"]: #Task | #Group
}
#Node: #Task | #Group
#Project: {
	name!: string
	tasks?: [string]: #Task | #Group
	...
}

#Loose: {x?: int, deps?: [...#Any]}
#Other: {y?: int}
#Any: #Loose | #Other
-- dep/dep.cue --
package dep

import (
	"strings"

	"mod.test/schema"
)

schema.#Project

name: "dep"

#local: schema.#Task & {out: "local"}

tasks: {
	a: {cmd: "a"}
	b: schema.#Task & {cmd: "b", deps: [a]}
	g: {type: "group", deps: [a], inner: {cmd: "inner"}}
	outer: {type: "group", sub: {type: "group", leaf: {cmd: "leaf", meta: label: "l"}}}
	viaLocal: #local & {cmd: "x"}
	hid: {cmd: "x", _secret: 1}
	abstract: {cmd: string}
	for k in ["t1", "t2"] {
		(k): {cmd: k}
	}

	// Allowed here, as this file embeds #Project.
	bad: {cmd: "x", bogus: 1}
	badNested: {cmd: "x", meta: {label: "l", bogus: 1}}
	badGroup: {type: "group", kid: {cmd: "x", bogus: 1}, fine: {cmd: "fine"}}
}

inner: {
	schema.#Project
	name: "inner"
	tasks: {
		ok: {cmd: "ok"}
		bad: {cmd: "x", bogus: 1}
	}
}
ref: schema.#Project & {
	name: "ref"
	tasks: ok: {cmd: "ok"}
}

plain: {cmd: "plain"}
embedded: {schema.#Task, cmd: "e", extra: 1}
partial: schema.#Task
opt?: schema.#Task & {cmd: "o"}
#Def: schema.#Task & {cmd: "d"}
#Holder: task: schema.#Task & {cmd: "h"}
(strings.ToLower("DYNAMIC")): schema.#Task & {cmd: "dyn"}
gen: {
	for k in ["c1", "c2"] {
		(k): schema.#Task & {cmd: k}
	}
}
guarded: {
	if name == "dep" {
		task: schema.#Task & {cmd: "guarded"}
	}
}
alias: tasks.a
nested: deep: schema.#Task & {cmd: "deep"}
list: [schema.#Task & {cmd: "l0"}]
either: schema.#Task & {cmd: "x"} | schema.#Group & {type: "group"}
defaulted: *(schema.#Task & {cmd: "x"}) | schema.#Group
broken: schema.#Task & {cmd: 1}
cyclic: schema.#Task & {cmd: "c", deps: [cyclic]}
loose: schema.#Loose & {x: 1}
-- upper/upper.cue --
package upper

import (
	"mod.test/schema"
	"mod.test/dep"
)

schema.#Project

name: "upper"

tasks: {
	mid: {cmd: "mid", deps: [dep.tasks.a, dep.tasks.b]}
	top: {cmd: "top", deps: [mid, dep.tasks.g]}
}
-- failing/failing.cue --
package failing

import "mod.test/schema"

ok: schema.#Task & {cmd: "ok"}
s: {x: schema.#Task & {cmd: "x"}}
s: [1]
-- conflict/conflict.cue --
package conflict

import "mod.test/schema"

ok: schema.#Task & {cmd: "ok"}
ok: schema.#Group
